# ──────────────────────────────────────────────
# Конфигурация приложения автоторговли (пример).
# Скопируй в .env и отредактируй под себя.
# ──────────────────────────────────────────────

# Режим окружения: development | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# БД (SQLite по умолчанию; для прототипа достаточно)
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# ─── Биржа (тестовый режим использует только публичное API, ключи не нужны) ───
EXCHANGE=binance
# Ключи для live-режима (торговля реальными деньгами). Хранятся в БД (зашифрованно)
# через раздел "Кошелёк" в Настройках. Эти переменные ниже — резерв/для MarketService.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Live-режим (реальные деньги) ───
# Ключ шифрования api_secret кошельков (Fernet). Если пуст — используется
# производный ключ от APP_PASSWORD (только для прототипа; в продакшене задайте
# явный ключ, напр. сгенерируйте python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
WALLET_ENCRYPTION_KEY=
# Разрешить автоматическую торговлю реальными деньгами (авто-режим в live).
# По умолчанию выключено для безопасности. Меняется также кнопкой в Настройках.
LIVE_AUTO_ENABLED=false

# ─── Стартовый баланс тестового режима ───
PAPER_INITIAL_BALANCE=100

# ─── Kronos (ML-ядро) ───
KRONOS_MODEL=NeoQuasar/Kronos-base
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=cuda             # cuda | cpu
KRONOS_TOP_P=0.95
KRONOS_TEMPERATURE=1.2
KRONOS_SAMPLE_COUNT=3
KRONOS_PRED_LEN=8              # свечей вперёд

# ─── Управление данными (раздел 6 плана) ───
DATA_KRONOS_CONTEXT=512
DATA_INDICATOR_WARMUP=200
DATA_LIVE_BUFFER=100
DATA_BACKTEST_WINDOW=2000
DATA_RETENTION_MULTIPLIER=1.1

# ─── Стратегия (раздел 4 плана) ───
COMMISSION_RATE=0.001          # 0.1% Binance spot
SLIPPAGE_RATE=0.0005           # 0.05%
MARGIN_OF_SAFETY=0.003         # запас для порога безубыточности
RISK_FRACTION=0.01             # 1% капитала на сделку
ENTRY_THRESHOLD=0.65           # порог S_entry
ATR_K_STOP=1.5                 # множитель стоп-лосса
ATR_K_TAKE=3.0                 # множитель тейк-профита (R/R ≈ 2)
MAX_POSITION_PCT=0.30          # не более 30% equity в одной сделке
MAX_HOLD_PERIODS=48            # time-stop в свечах

# ─── Новости (LLM сентимент + бесплатный RSS/Tavily) ───
NEWS_ENABLED=true
NEWS_PROVIDER=groq             # "groq" (дефолт, бесплатно) | "openrouter" | "gemini"
# Groq API: https://console.groq.com/keys (бесплатно 1000+ req/день)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b    # qwen/qwen3.8-27b | openai/gpt-oss-120b | openai/gpt-oss-20b
# HTTP-прокси для LLM/Tavily (если требуется обход блокировок, напр. http://127.0.0.1:10809)
NEWS_PROXY=
# Tavily Search API: https://tavily.com (опционально; если пуст — используется встроенный бесплатный RSS)
TAVILY_API_KEY=
NEWS_CACHE_TTL=3600            # время жизни кеша сентимента (в секундах)
NEWS_LOOKBACK_DAYS=3           # за сколько дней анализировать новости

